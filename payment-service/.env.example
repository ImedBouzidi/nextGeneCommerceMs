DB_NAME=e-com-payment-db
DB_USERNAME=payment_app
PAYMENT_DB_PASSWORD=replace-with-a-strong-payment-database-password
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-the-keycloak-admin-password
KEYCLOAK_CLIENT_SECRET=replace-with-the-keycloak-client-secret

# --- Acquirer -----------------------------------------------------------------
# fake   = offline simulator; no keys, no network, drives every decline/timeout
#          path used by the automated tests. This is the default on purpose: the
#          service must never be able to reach a real card network by accident.
# stripe = real acquirer. Requires the two keys below.
PAYMENT_GATEWAY=fake
PAYMENT_CURRENCY=TND

# Test-mode keys only (sk_test_..., whsec_...). Use sk_live_ only in a real
# deployment with a secrets manager — never in this file.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# --- Tunisian provider -------------------------------------------------------
# Konnect is a payment facilitator certified by the Central Bank of Tunisia and is
# the one that can process e-Dinar, D17, ClicToPay and Tunisian bank cards.
# No international acquirer can: Stripe does not operate in Tunisia.
# Credentials: dashboard.konnect.network -> wallet_id:api_secret
PAYMENT_GATEWAY_LOCAL=unconfigured
KONNECT_BASE_URL=https://sandbox.konnect.network/api/public/payments
KONNECT_API_KEY=
KONNECT_SANDBOX=true
